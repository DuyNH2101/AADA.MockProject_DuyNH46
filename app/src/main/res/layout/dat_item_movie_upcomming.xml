<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <!-- Poster -->
        <ImageView
            android:id="@+id/movie_poster"
            android:layout_width="70dp"
            android:layout_height="90dp"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="8dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/app_name"
            tools:src="@drawable/ic_movie" />

        <!-- Movie Title -->
        <TextView
            android:id="@+id/movie_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/movie_poster"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            tools:text="Movie Name"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- Start Time -->
        <TextView
            android:id="@+id/movie_release_date_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/movie_title"
            android:layout_toEndOf="@id/movie_poster"
            android:text="Start Time:"
            android:textSize="13sp"
            android:textColor="#555555" />

        <TextView
            android:id="@+id/movie_release_date_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/movie_release_date_label"
            android:layout_alignBaseline="@id/movie_release_date_label"
            android:textColor="#E65381"
            android:textSize="13sp"
            tools:text="2024-10-20" />

        <!-- Rating -->
        <TextView
            android:id="@+id/movie_rating_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/movie_release_date_label"
            android:layout_toEndOf="@id/movie_poster"
            android:text="Rating:"
            android:textSize="13sp"
            android:textColor="#555555" />

        <TextView
            android:id="@+id/movie_rating_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/movie_rating_label"
            android:layout_alignBaseline="@id/movie_rating_label"
            android:textColor="#E65381"
            android:textSize="13sp"
            tools:text="8.5/10" />

        <!-- Overview -->
        <TextView
            android:id="@+id/movie_overview_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/movie_rating_label"
            android:layout_toEndOf="@id/movie_poster"
            android:text="Overview:"
            android:textColor="#E65381"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/movie_overview_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/movie_overview_label"
            android:layout_toEndOf="@id/movie_poster"
            android:textSize="12sp"
            android:textColor="@android:color/black"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua..." />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>
