<?xml version="1.0" encoding="utf-8"?>
<layout>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@drawable/border_light"
        xmlns:app="http://schemas.android.com/apk/res-auto">
        <ImageView
            android:id="@+id/item_view_grid_movie_poster"
            android:layout_width="150dp"
            android:layout_height="180dp"
            android:scaleType="centerCrop"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:src="@drawable/ic_movie" />

        <TextView
            android:id="@+id/item_view_grid_movie_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/item_view_grid_movie_poster"
            app:layout_constraintStart_toStartOf="@id/item_view_grid_movie_poster"
            app:layout_constraintEnd_toEndOf="@id/item_view_grid_movie_poster"
            android:text="Movie Name"
            android:textColor="@android:color/black"
            android:textAlignment="center"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>