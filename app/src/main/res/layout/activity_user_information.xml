<?xml version="1.0" encoding="utf-8"?>
<layout>
    <data>
        <variable
            name="userModel"
            type="com.example.aadamockproject_duynh46.domain.model.UserModel" />
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:fitsSystemWindows="true"
        tools:context=".activities.UserInformationActivity">
        <Button
            android:id="@+id/user_edit_cancel_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="20dp"
            android:text="Cancel"
            android:textAllCaps="false"/>
        <androidx.cardview.widget.CardView
            android:id="@+id/user_image_view_container"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:cardCornerRadius="50dp"
            app:cardElevation="4dp"
            android:layout_margin="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >
            <ImageView
                android:id="@+id/user_edit_image"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:scaleType="centerCrop"
                app:srcCompat="@mipmap/ic_launcher_round"
                android:imageBase64="@{userModel.image}"/>
        </androidx.cardview.widget.CardView>
        <Button
            android:id="@+id/user_edit_done_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="20dp"
            android:text="Done"
            android:textAllCaps="false"/>
        <TextView
            android:id="@+id/user_edit_name_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/user_image_view_container"
            app:layout_constraintStart_toStartOf="parent"
            android:text="Name" />
        <EditText
            android:id="@+id/user_edit_name_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/user_edit_name_mark"
            android:text="@{userModel.fullName}"
            android:hint="Name"/>
        <TextView
            android:id="@+id/user_edit_email_mark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            app:layout_constraintTop_toBottomOf="@id/user_edit_name_edit_text"
            app:layout_constraintStart_toStartOf="parent"
            android:text="sample@example.com" />
        <EditText
            android:id="@+id/user_edit_email_edit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/user_edit_email_mark"
            android:text="@{userModel.email}"
            android:hint="Email"/>
        <ImageView
            android:id="@+id/user_edit_birthday_icon"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/user_edit_email_edit_text"
            android:src="@drawable/birthday_icon"/>
        <EditText
            android:id="@+id/user_edit_birthday_edit_text"
            android:layout_width="300dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/user_edit_birthday_icon"
            app:layout_constraintTop_toTopOf="@id/user_edit_birthday_icon"
            app:layout_constraintBottom_toBottomOf="@id/user_edit_birthday_icon"
            android:text="@{userModel.birthday}"/>
        <ImageView
            android:id="@+id/user_edit_person_icon"
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/user_edit_birthday_icon"
            android:src="@drawable/person_icon"/>
        <RadioGroup
            android:id="@+id/user_edit_gender_radio_group"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            app:layout_constraintStart_toEndOf="@id/user_edit_person_icon"
            app:layout_constraintTop_toTopOf="@id/user_edit_person_icon"
            app:layout_constraintBottom_toBottomOf="@id/user_edit_person_icon"
            android:orientation="horizontal"
            android:gravity="center">
            <RadioButton
                android:id="@+id/user_edit_radio_male"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Male"
                android:layout_marginEnd="16dp"
                android:checked="true"
                android:buttonTint="#D769AF"/>

            <RadioButton
                android:id="@+id/user_edit_radio_female"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Female"
                android:buttonTint="#D769AF"/>
        </RadioGroup>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>