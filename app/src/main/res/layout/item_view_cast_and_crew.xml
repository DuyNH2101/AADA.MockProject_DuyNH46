<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools">
    <data>
        <variable
            name="people"
            type="com.example.aadamockproject_duynh46.domain.model.PeopleModel"/>
    </data>
    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        xmlns:app="http://schemas.android.com/apk/res-auto">

        <ImageView
            android:id="@+id/item_view_cast_and_crew_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:src="@drawable/person_icon"
            android:srcImage="@{people.profilePath}"/>
        <TextView
            android:id="@+id/item_view_cast_and_crew_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/item_view_cast_and_crew_image"
            app:layout_constraintStart_toStartOf="@id/item_view_cast_and_crew_image"
            app:layout_constraintEnd_toEndOf="@id/item_view_cast_and_crew_image"
            tools:text="Cast &amp; Crew Name"
            android:text="@{people.name}"
            android:textColor="@color/black"
            android:textSize="16sp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>